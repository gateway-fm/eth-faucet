# BRANDING

# Selects a brand from src/brands/<id> at build time (default: base = Gateway).
# e.g. VITE_BRAND=teiza. Also settable via docker build --build-arg VITE_BRAND=teiza.
VITE_BRAND=base

VITE_FAVICON_PATH=/favicon.png
VITE_LOGO_PATH=/gpt-logo-white-transparent.svg
VITE_BACKGROUND_PATH=/gpt-background.jpg
